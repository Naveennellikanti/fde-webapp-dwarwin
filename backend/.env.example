# ---- LLM backend -------------------------------------------------------------
# auto   = use Ollama if reachable, else Groq   (default)
# ollama = force local  |  groq = force hosted
LLM_BACKEND=auto

# Local (open-source model, data never leaves your machine)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted fallback (open-source Llama via Groq). Only schema + question transit.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- SQL generation strategy -------------------------------------------------
# native    = direct provider call (default)
# langchain = same step as an LCEL chain (needs langchain-core). Identical results.
SQL_GENERATOR=native

# ---- Privacy -----------------------------------------------------------------
# true  = send ONLY column names + dtypes to the model (no data values at all)
# false = send a few PII-masked sample rows (better SQL accuracy)
SCHEMA_ONLY=false
SAMPLE_ROWS=3

# ---- Limits / cost control ---------------------------------------------------
MAX_SQL_RETRIES=3
RESULT_ROW_CAP=5000
SESSION_TOKEN_BUDGET=2000000
MAX_UPLOAD_MB=50
SESSION_TTL_MINUTES=120

# ---- CORS (comma-separated origins allowed to call this API) -----------------
CORS_ORIGINS=http://localhost:3000
